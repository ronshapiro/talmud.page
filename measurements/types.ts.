function makeIndex(measurements: Measurement[]): Record<string, Measurement> {
  const index: Record<string, Measurement> = {};
  for (const measurement of measurements) {
    index[measurement.name.hebrew] = measurement;
    index[measurement.name.english] = measurement;
    index[measurement.name.englishTransliteration ?? ""] = measurement;
    index[measurement.name.hebrewPlural ?? ""] = measurement;
    index[measurement.name.hebrewDouble ?? ""] = measurement;
    for (const alias of measurement.aliases ?? []) {
      index[Object.values(alias)[0]] = measurement;
    }
  }
  delete index[""];
  return index;
}

