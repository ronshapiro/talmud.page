interface Hebrew {
  hebrew: string;
}

interface English {
  english: string;
}

interface Translatable extends Hebrew, English {
  englishTransliteration?: string;
  hebrewDouble?: string;
  hebrewPlural?: string;
}

interface Conversion {
  unit: string;
  amount: number;
}

interface ConversionRange {
  minimum: Conversion;
  maximum: Conversion;
}

interface Unit extends Translatable {
  hundreds?: Unit;
  thousands?: Unit;
  oneHundredth?: Unit;
  oneThousandth?: Unit;
}

interface ModernUnits {
  chayimNaeh: number;
  chazonIsh: number;
  rambam: number;
  unit: Unit;
}

interface Measurement {
  name: Translatable;
  aliases?: (Hebrew | English)[];
  conversion?: Conversion;
  conversionRange?: ConversionRange;
  modernUnits?: ModernUnits;
}

