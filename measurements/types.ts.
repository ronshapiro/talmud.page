function inModernUnits(
  amount: number, name: string, index: Record<string, Measurement>,
): ModernUnits {
  if (index[name].modernUnits) {
    const base = index[name].modernUnits!;
    return {
      // do not submit: if the unit changes across conversions this won't be true! all units must be consistent across measurements in an index
      chayimNaeh: amount * base.chayimNaeh,
      chazonIsh: amount * base.chazonIsh,
      rambam: amount * base.rambam,
      unit: base.unit,
    };
  }
  // do not submit: need to deal with conversion ranges
  const conversion = index[name].conversion!;
  return inModernUnits(amount * conversion.amount, conversion.unit, index);
}

function normalize(base: ModernUnits, key: "chayimNaeh" | "chazonIsh" | "rambam"): ModernUnits {
  if (base[key] >= 1000 && base.unit.thousands) {
    return normalize({
      chayimNaeh: base.chayimNaeh / 1000,
      chazonIsh: base.chazonIsh / 1000,
      rambam: base.rambam / 1000,
      unit: base.unit.thousands!,
    }, key);
  }
  if (base[key] >= 100 && base.unit.hundreds) {
    return normalize({
      chayimNaeh: base.chayimNaeh / 100,
      chazonIsh: base.chazonIsh / 100,
      rambam: base.rambam / 100,
      unit: base.unit.hundreds!,
    }, key);
  }
  if (base[key] < .001 && base.unit.oneThousandth) {
    return normalize({
      chayimNaeh: base.chayimNaeh * 1000,
      chazonIsh: base.chazonIsh * 1000,
      rambam: base.rambam * 1000,
      unit: base.unit.oneThousandth!,
    }, key);
  }
  if (base[key] < .01 && base.unit.oneHundredth) {
    return normalize({
      chayimNaeh: base.chayimNaeh * 100,
      chazonIsh: base.chazonIsh * 100,
      rambam: base.rambam * 100,
      unit: base.unit.oneHundredth!,
    }, key);
  }
  return base;
}

function modernToString(modernUnits: ModernUnits): string {
  modernUnits = normalize(modernUnits, "chazonIsh");
  return `${modernUnits.chazonIsh} ${modernUnits.unit.english}`;
}

